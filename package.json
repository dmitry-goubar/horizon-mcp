{
  "name": "horizon-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling Omnissa Horizon Client via screen automation",
  "type": "module",
  "license": "MIT",
  "author": "Dmitry Goubar",
  "bin": {
    "horizon-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sensaiworks/horizon-mcp.git"
  },
  "homepage": "https://github.com/sensaiworks/horizon-mcp#readme",
  "bugs": {
    "url": "https://github.com/sensaiworks/horizon-mcp/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/input.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.1"
  }
}
